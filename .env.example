# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Firebase Client Configuration (Configuração Pública Web)
# Obtenha estes valores no console do Firebase: Configurações do Projeto > Seus Aplicativos > Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (fundação em preparação — NÃO conectado ao frontend ainda)
# Nomes apenas, sem valores reais. VITE_SUPABASE_ANON_KEY pode ser usada no
# cliente desde que a Row Level Security esteja correta (é a premissa de todo
# o desenho em supabase/). SUPABASE_SERVICE_ROLE_KEY NUNCA deve usar prefixo
# VITE_ e NUNCA pode ser incluída no bundle, no Git, em logs ou no frontend —
# por isso nem sequer é listada aqui como variável do cliente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
